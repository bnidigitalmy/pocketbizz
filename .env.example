# PocketBizz Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ================================
# DATABASE CONFIGURATION (Required)
# ================================
# Get your connection string from Neon.tech Console
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@your-host.neon.tech/your_database?sslmode=require

# ================================
# SESSION SECRET (Required)
# ================================
# Generate a strong 64-byte hex string with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_64_byte_hex_string_here_change_this_in_production

# ================================
# REDIS (Required for Production - Optional for Development)
# ================================
# For Railway: Add Redis plugin and use REDIS_URL from environment
# For local dev: Use redis://localhost:6379
# Sessions and rate limiting will use Redis for persistence
REDIS_URL=redis://localhost:6379

# ================================
# SERVER CONFIGURATION
# ================================
PORT=5000
NODE_ENV=development

# ================================
# CORS SECURITY (Required for Production)
# ================================
# Comma-separated list of allowed origins
# Update with your production domain
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,https://yourdomain.com

# ================================
# SENTRY ERROR MONITORING (Required for Production)
# ================================
# Get your DSN from sentry.io after creating a project
# Backend DSN (Node.js project)
SENTRY_DSN=https://your-backend-key@your-org.ingest.sentry.io/your-project-id
# Frontend DSN (React project) - can be same or different
VITE_SENTRY_DSN=https://your-frontend-key@your-org.ingest.sentry.io/your-project-id

# Google Drive API (Optional - for auto-sync feature)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_REFRESH_TOKEN=

# ToyyibPay Payment Gateway (Optional - for subscription billing)
# TOYYIBPAY_SECRET_KEY=
# TOYYIBPAY_CATEGORY_CODE=

# Stripe Payment Gateway (Optional - alternative to ToyyibPay)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
